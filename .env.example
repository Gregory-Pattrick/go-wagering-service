# HTTP listener address
HTTP_ADDR=127.0.0.1:8080

# Allowed values: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# PostgreSQL administrator password for local development only.
# Application and migration credentials are defined in the bootstrap SQL.
POSTGRES_ADMIN_PASSWORD=postgres_local

# PostgreSQL connection for running Go directly on the host.
# Docker Compose uses postgres as the hostname instead.
DATABASE_URL=postgres://wagering_app:wagering_app_local@127.0.0.1:5432/wagering?sslmode=disable

# Local Keycloak bootstrap administrator password.
KEYCLOAK_ADMIN_PASSWORD=admin_local