# HTTP listener address
HTTP_ADDR=127.0.0.1:8080

# Allowed values: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# PostgreSQL administrator password for local development only.
# Application and migration credentials are defined in the bootstrap SQL.
POSTGRES_ADMIN_PASSWORD=postgres_local

# PostgreSQL connection for running Go directly on the host.
# Docker Compose uses postgres as the hostname instead.
DATABASE_URL=postgres://wagering_app:wagering_app_local@127.0.0.1:5432/wagering?sslmode=disable

# Local Keycloak bootstrap administrator password.
KEYCLOAK_ADMIN_PASSWORD=admin_local
# Host OIDC defaults, shown explicitly. Compose uses the internal Keycloak JWKS URL.
OIDC_ISSUER=http://localhost:8081/realms/wagering
OIDC_AUDIENCE=wagering-api
OIDC_JWKS_URL=http://localhost:8081/realms/wagering/protocol/openid-connect/certs
OIDC_PROVIDER_CLIENTS={"provider-a":"provider-a","provider-b":"provider-b"}
OIDC_INTERNAL_CLIENT=wallet-service

# Optional local Grafana administrator fixture.
GRAFANA_ADMIN_PASSWORD=grafana_local

# Runtime SQS credentials are provisioned into role-specific Docker volumes.
# See .env.sqs.example, docs/broker-authentication.md and scripts/local-stack.ps1.
