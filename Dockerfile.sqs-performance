FROM golang:1.27.1-bookworm AS source
WORKDIR /app
ENV GOTOOLCHAIN=local
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY . .
RUN CGO_ENABLED=1 go test -race -count=1 ./cmd/load-sqs
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -o /out/load-sqs ./cmd/load-sqs && \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -o /out/service ./cmd/service && \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -o /out/workers ./cmd/workers && \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -o /out/consumer ./cmd/consumer
FROM scratch
COPY --from=source /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=source /out /out
USER 65532:65532
ENTRYPOINT ["/out/load-sqs"]
